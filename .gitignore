# ─────────────────────────────────────────────────────────────────────────────
# DP-MMFL .gitignore
# Commit: source (src/, scripts/, dashboard/, tests/), configs/, docs/, report and
# paper sources (.tex, .bib, .bst, main.bbl, figures), demo READMEs and info pages.
# Never commit: patient data or labels, derived features, trained weights, run
# outputs, built PDFs/zips, secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data (CheXpert licence: no redistribution) and derived artefacts ────────
CheXpert-v1.0-small/
cache/
splits/partition.json
*.npy
*.npz
*.parquet

# ── Experiment outputs and trained models (regenerated by scripts/) ─────────
*.pth
*.ckpt

# ── Demo: CheXpert images may not be redistributed; patient records stay local
demo/images/
demo/by_label/**/*.jpg
demo/presentation/**/*.jpg
demo/patient_records.jsonl
# CSVs with CheXpert patient IDs, demographics and labels (dataset rows)
demo/demo_samples.csv
demo/by_label/predictions.csv
demo/presentation/predictions.csv

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
# .python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ── Secrets and local configuration ─────────────────────────────────────────
.env
.env.*
.streamlit/secrets.toml

# ── LaTeX build artefacts (report/, paper/) ─────────────────────────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.synctex.gz
*.toc
*.xdv
*.run.xml
*-blx.bib
report/main.pdf
# Compiled manuscript, ESM, cover letter and graphical abstract (figures/*.pdf stay tracked)
paper/*.pdf
# Keep the pre-built bibliography so the paper compiles straight from the repo
!paper/main.bbl

# ── Packaged deliverables (rebuilt for Overleaf / submission) ───────────────
*.zip

# ── Editors and OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# deployment: keep trained heads, results and tab_stats so the live dashboard works
!models/**/*.pt
